# WordPress Theme .gitignore

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# Editor Files
*.swp
*.swo
*~
.project
.settings
.buildpath
.idea/
*.sublime-project
*.sublime-workspace
.vscode/
*.code-workspace

# Node.js (if using build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock

# Build Output (if using webpack/build process)
/assets/dist/
/build/
/node_modules/
*.map

# Logs
logs
*.log

# Environment Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Composer (if using PHP dependencies)
/vendor/
composer.lock

# Cache
.cache/
.temp/
tmp/

# Compressed Files
*.zip
*.tar
*.tar.gz
*.rar

# Backup Files
*.bak
*.backup
*.old

# WordPress Specific (if testing locally)
wp-config.php
wp-content/uploads/
wp-content/blogs.dir/
wp-content/upgrade/
wp-content/backup-db/
wp-content/cache/
wp-content/debug.log

# Testing
/tests/
phpunit.xml
.phpunit.result.cache

# Documentation (if you want to keep docs separate)
# /docs/

# Exclude compiled/minified files if you have a build process
# *.min.js
# *.min.css

# Keep these folders but ignore their contents
!.gitkeep